PORT=2525
HOST=0.0.0.0
LOG_LEVEL=info

# The platform API owns mailbox storage; this gateway only relays to it.
# Docker Compose overrides this with http://drive-osx-api:7000.
API_BASE_URL=http://localhost:7000
API_VERSION=v1

# Shared secret this gateway presents to the API when delivering inbound mail
# and checking mailbox credentials — those calls have no user session to carry.
# Must be identical to MAIL_GATEWAY_TOKEN in drive-osx-api/.env, or the API
# rejects every delivery.
# Generate with: openssl rand -hex 32
MAIL_GATEWAY_TOKEN=replace-with-a-shared-gateway-secret

SMTP_BANNER=Drive OSX Mail Service Ready
MAX_CONNECTIONS=100
MAX_MESSAGE_BYTES=26214400

# Domain used in the outbound EHLO greeting and generated Message-IDs. Should
# match MAIL_DOMAIN in drive-osx-api/.env.
MAIL_DOMAIN=driveosx.com

# Internal HTTP port the platform API calls to hand off outbound mail
# (POST /deliver). Not published to the host — only reachable inside the
# Compose network.
RELAY_PORT=2526

# Dev-only: when set, outbound delivery always connects here instead of
# resolving MX records. Real port-25 delivery does not work from a laptop or
# most cloud VMs (blocked outbound, no reverse DNS, no sending reputation) —
# point this at a local catch-all like Mailpit. Leave unset in production.
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=1025

# ------------------------------------------------------------------- DKIM
# Signs every outbound message. Real providers (Gmail, Outlook) are likely to
# reject or spam-bucket mail with no valid signature — this is required for
# real-world delivery, not optional polish. Generate with:
#   ./scripts/generate-dkim-key.sh
# which writes the key pair to ./secrets/ (gitignored) and prints the DNS TXT
# record to publish for DKIM_SELECTOR. Leave both unset to send unsigned,
# e.g. for local testing against Mailpit.
DKIM_SELECTOR=mail
DKIM_PRIVATE_KEY_PATH=./secrets/dkim-private.pem

# -------------------------------------------------------------- STARTTLS
# Without these, STARTTLS is still offered but falls back to smtp-server's
# built-in test certificate — trusted by no one. Point these at a real
# certificate (e.g. Let's Encrypt: certbot certonly --standalone -d
# mail.driveosx.com) copied or symlinked into ./tls (gitignored).
TLS_KEY_PATH=./tls/privkey.pem
TLS_CERT_PATH=./tls/fullchain.pem
