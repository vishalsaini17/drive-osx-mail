PORT=2525
HOST=0.0.0.0
LOG_LEVEL=info

# The platform API owns mailbox storage; this gateway only relays to it.
# Docker Compose overrides this with http://drive-osx-api:7000.
API_BASE_URL=http://localhost:7000
API_VERSION=v1

# Shared secret this gateway presents to the API when delivering inbound mail
# and checking mailbox credentials — those calls have no user session to carry.
# Must be identical to MAIL_GATEWAY_TOKEN in drive-osx-api/.env, or the API
# rejects every delivery.
# Generate with: openssl rand -hex 32
MAIL_GATEWAY_TOKEN=replace-with-a-shared-gateway-secret

SMTP_BANNER=Drive OSX Mail Service Ready
MAX_CONNECTIONS=100
MAX_MESSAGE_BYTES=26214400

# Domain used in the outbound EHLO greeting and generated Message-IDs. Should
# match MAIL_DOMAIN in drive-osx-api/.env.
MAIL_DOMAIN=driveosx.com

# Internal HTTP port the platform API calls to hand off outbound mail
# (POST /deliver). Not published to the host — only reachable inside the
# Compose network.
RELAY_PORT=2526

# When set, outbound delivery always connects here (with SMTP AUTH over
# STARTTLS) instead of resolving MX records and delivering direct-to-MX on
# port 25. This is the entire switch between the two outbound delivery
# layers — deliverViaSmtp() (src/outbound/deliver.ts) picks relay vs.
# direct-to-MX purely on whether SMTP_RELAY_HOST is set, so moving between
# them later is a config change, not a code change.
#
# Dev: point this at a local catch-all like Mailpit — leave SMTP_RELAY_USER/
# PASSWORD unset, Mailpit takes unauthenticated connections.
#
# Production, current setup — Oracle Cloud blocks outbound port 25 by
# default, which rules out direct-to-MX delivery, so outbound mail relays
# through OCI Email Delivery:
#   1. Console → Developer Services → Email Delivery → set up the sending
#      domain (must match MAIL_DOMAIN) and add it as an Approved Sender.
#   2. Publish the SPF and DKIM records OCI's console displays for that
#      domain (in addition to, not instead of, DKIM_SELECTOR/
#      DKIM_PRIVATE_KEY_PATH below — this gateway's own DKIM signature and
#      OCI's are independent and both apply).
#   3. Identity & Security → Domains → your domain → Users → your user →
#      SMTP Credentials → Generate SMTP Credentials. This username/password
#      pair is NOT your OCI login — it's a separate credential shown once,
#      scoped to SMTP only.
#   4. Set the three values below from that credential and region:
#     SMTP_RELAY_HOST=smtp.email.<region>.oci.oraclecloud.com   # e.g. smtp.email.us-ashburn-1.oci.oraclecloud.com
#     SMTP_RELAY_PORT=587
#     SMTP_RELAY_USER=<the generated SMTP username>
#     SMTP_RELAY_PASSWORD=<the generated SMTP password>
#
# Future, once outbound port 25 is open on this host: leave all four blank
# again to fall back to direct-to-MX delivery. No code change either way —
# same swap works for any other authenticated relay (SendGrid, Mailgun, SES,
# Postmark, ...), typically also host:587.
SMTP_RELAY_HOST=
SMTP_RELAY_PORT=1025
SMTP_RELAY_USER=
SMTP_RELAY_PASSWORD=

# Every user's mailbox address (alice@driveosx.com, ...) is used as-is in the
# outbound envelope by default — fine for direct-to-MX delivery, which has no
# concept of "approved senders".
#
# When set, this overrides only the SMTP envelope sender (MAIL FROM) for
# relay deliveries to one pre-approved address, e.g. mail@driveosx.com.
# Recipients still see and can reply to the real sender: the "From:" header
# inside the message is untouched, only the invisible envelope/bounce address
# changes. Safe for SPF/DKIM/DMARC — they check the envelope and header
# *domain*, not the local part, and the domain (driveosx.com) doesn't change.
#
# NOT sufficient on its own for OCI Email Delivery specifically: confirmed by
# testing, OCI also validates the message's own "From:" header against its
# Approved Senders list, not just the envelope — so a per-user "From:" still
# gets rejected regardless of this setting. The OCI_* block below (auto-
# approving every address at signup) is what actually solves that for OCI.
# This variable is kept because it's still useful for a relay that only
# checks the envelope (common for non-OCI transactional providers) — for
# OCI, leave it unset unless paired with the OCI_* auto-approval below.
SMTP_RELAY_ENVELOPE_FROM=

# --------------------------------------------------- OCI sender auto-approval
# OCI Email Delivery rejects any "From:" address that isn't an Approved
# Sender in its console — checked per-message, and there's no domain-wide
# approval (confirmed by testing: alice@driveosx.com was rejected even
# though driveosx.com itself shows Active/verified). Approving addresses by
# hand doesn't scale to self-serve signups, so the API registers every new
# mailbox automatically: identity.service.ts's register() fires a
# `user.registered` domain event, its handler enqueues a `mail.register-sender`
# job (workers/handlers.ts), and that job POSTs here to
# /provision-sender (src/relay-server.ts), which calls OCI's CreateSender API
# (src/outbound/oci-senders.ts). Runs from the background queue with retries,
# not on the signup request path — a slow/unavailable relay provider never
# blocks or fails registration.
#
# Leave all six unset to no-op /provision-sender entirely — safe for dev, and
# for any relay that doesn't require sender approval; once back to
# direct-to-MX delivery there's no such concept to satisfy either.
#
# These are separate from SMTP_RELAY_USER/PASSWORD above: those authenticate
# the SMTP connection itself, these authenticate OCI's control-plane API
# (request-signed with an API key, not SMTP AUTH — see oci-signer.ts). Use a
# dedicated OCI user scoped to nothing but "manage email-senders" in this
# compartment — never your own login's key.
#
#   1. Identity & Security → Domains → Default → Users → Create User (a
#      dedicated automation user, e.g. drive-osx-mail-automation).
#   2. Identity & Security → Policies → Create Policy, in the compartment
#      your Email Domain lives in:
#        Allow group <group containing that user> to manage email-senders in compartment <compartment name>
#   3. Open that user → API Keys → Add API Key → let OCI generate the pair →
#      download the private key, copy the fingerprint. Its "Configuration
#      File Preview" also shows the tenancy and user OCIDs below.
#   4. Identity & Security → Compartments → the compartment from step 2 →
#      copy its OCID for OCI_EMAIL_COMPARTMENT_ID.
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_API_KEY_FINGERPRINT=
# Private key file from step 3 — copy or symlink into ./secrets (gitignored,
# same as the DKIM key below). Never commit it.
OCI_API_PRIVATE_KEY_PATH=./secrets/oci-api-key.pem
OCI_REGION=ap-mumbai-1
OCI_EMAIL_COMPARTMENT_ID=
# Override only if OCI's Email Delivery control-plane host doesn't match the
# usual email.<region>.oci.oraclecloud.com pattern for your region — check
# Oracle's current API reference if /provision-sender starts 404ing.
OCI_EMAIL_API_HOST=

# ------------------------------------------------------------------- DKIM
# Signs every outbound message. Real providers (Gmail, Outlook) are likely to
# reject or spam-bucket mail with no valid signature — this is required for
# real-world delivery, not optional polish. Generate with:
#   ./scripts/generate-dkim-key.sh
# which writes the key pair to ./secrets/ (gitignored) and prints the DNS TXT
# record to publish for DKIM_SELECTOR. Leave both unset to send unsigned,
# e.g. for local testing against Mailpit.
DKIM_SELECTOR=mail
DKIM_PRIVATE_KEY_PATH=./secrets/dkim-private.pem

# -------------------------------------------------------------- STARTTLS
# Without these, STARTTLS is still offered but falls back to smtp-server's
# built-in test certificate — trusted by no one. Point these at a real
# certificate (e.g. Let's Encrypt: certbot certonly --standalone -d
# mail.driveosx.com) copied or symlinked into ./tls (gitignored).
TLS_KEY_PATH=./tls/privkey.pem
TLS_CERT_PATH=./tls/fullchain.pem
